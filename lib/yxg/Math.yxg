// ============================================================
// yxg.Math 标准库 - 数学函数与常量
// 所有方法均为 static，通过 Math.xxx() 调用
// 注意：当前 float 为 32 位，常量约保留 7 位有效数字
// ============================================================

pub class Math {

    // ==================== 常量 ====================
    pub static float PI  = 3.14159265;
    pub static float E   = 2.71828183;
    pub static float TAU = 6.28318531;

    // ==================== 内部状态（伪随机数生成器） ====================
    pri static uint _s0 = 12345;
    pri static uint _s1 = 67890;
    pri static uint _s2 = 0x9E3779B9;
    pri static uint _s3 = 0xC2B2AE35;

    // ==================== 绝对值 ====================
    pub static int abs(int x) {
        if x < 0 { return -x; }
        return x;
    }

    pub static float fabs(float x) {
        if x < 0.0 { return -x; }
        return x;
    }

    // ==================== 最值函数 ====================
    pub static int min(int a, int b) {
        if a < b { return a; }
        return b;
    }

    pub static int max(int a, int b) {
        if a > b { return a; }
        return b;
    }

    pub static float fmin(float a, float b) {
        if a < b { return a; }
        return b;
    }

    pub static float fmax(float a, float b) {
        if a > b { return a; }
        return b;
    }

    pub static int clamp(int value, int lo, int hi) {
        if value < lo { return lo; }
        if value > hi { return hi; }
        return value;
    }

    // ==================== 整数幂 ====================
    pub static int pow(int base, int exp) {
        if exp < 0 { return 0; }
        if exp == 0 { return 1; }
        int result = 1;
        for int i = 0; i < exp; i++ {
            result = result * base;
        }
        return result;
    }

    // ==================== 平方根 (牛顿迭代法) ====================
    pub static float sqrt(float x) {
        if x <= 0.0 { return 0.0; }
        float guess = x;
        for int i = 0; i < 20; i++ {
            guess = (guess + x / guess) / 2.0;
        }
        return guess;
    }

    // ==================== 三角函数 (泰勒级数) ====================
    pub static float sin(float x) {
        while x > PI  { x = x - TAU; }
        while x < -PI { x = x + TAU; }

        float x2 = x * x;
        float term = x;
        float result = x;
        term = term * x2 / 6.0;   result = result - term;   // x^3/3!
        term = term * x2 / 20.0;  result = result + term;   // x^5/5!
        term = term * x2 / 42.0;  result = result - term;   // x^7/7!
        term = term * x2 / 72.0;  result = result + term;   // x^9/9!
        term = term * x2 / 110.0; result = result - term;   // x^11/11!
        return result;
    }

    pub static float cos(float x) {
        return sin(x + PI / 2.0);
    }

    pub static float tan(float x) {
        float s = sin(x);
        float c = cos(x);
        return s / c;
    }

    // ==================== 阶乘 ====================
    pub static int factorial(int n) {
        if n <= 1 { return 1; }
        int result = 1;
        for int i = 2; i <= n; i++ {
            result = result * i;
        }
        return result;
    }

    // ==================== 最大公约数 / 最小公倍数 ====================
    pub static int gcd(int a, int b) {
        a = abs(a);
        b = abs(b);
        while b != 0 {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    pub static int lcm(int a, int b) {
        if a == 0 || b == 0 { return 0; }
        int g = gcd(a, b);
        return abs(a) / g * abs(b);
    }

    // ==================== 素数判断 ====================
    pub static bool isPrime(int n) {
        if n <= 1 { return false; }
        if n <= 3 { return true; }
        if n % 2 == 0 || n % 3 == 0 { return false; }
        int i = 5;
        while i * i <= n {
            if n % i == 0 || n % (i + 2) == 0 { return false; }
            i += 6;
        }
        return true;
    }

    // ==================== 伪随机数 ====================
    pri static uint _next() {
        uint x = _s0 + _s3;
        uint r1 = x << 7;
        uint r2 = x >> 25;
        uint result = (r1 | r2) + _s0;
        uint t = _s1 << 9;
        _s2 ^= _s0;
        _s3 ^= _s1;
        _s1 ^= _s2;
        _s0 ^= _s3;
        _s2 ^= t;
        _s3 = (_s3 << 11 | _s3 >> 21);
        return result;
    }

    pri static uint _splitmix32(uint z) {
        z = z + 0x9E3779B9;
        z = (z ^ (z >> 16)) * 0x85EBCA6B;
        z = (z ^ (z >> 13)) * 0xC2B2AE35;
        return z ^ (z >> 16);
    }

    pub static void srand(int seed) {
        uint z = seed;
        _s0 = _splitmix32(z);  z = z + 0x9E3779B9;
        _s1 = _splitmix32(z);  z = z + 0x9E3779B9;
        _s2 = _splitmix32(z);  z = z + 0x9E3779B9;
        _s3 = _splitmix32(z);
    }

    pub static int random() {
        return _next() & 0x7FFFFFFF;
    }

    pub static int randint(int lo, int hi) {
        if lo >= hi { return lo; }
        uint range = hi - lo + 1;
        uint r = _next();
        return lo + (r % range);
    }

    pub static float randfloat() {
        return _next() / 4294967296.0;
    }

    // ==================== 符号函数 ====================
    pub static int sign(int x) {
        if x > 0 { return 1; }
        if x < 0 { return -1; }
        return 0;
    }
}