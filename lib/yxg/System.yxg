// ============================================================
// yxg.System 标准库
// 所有方法均为 static，通过 System.xxx() 调用
// ============================================================

pub class System {

    // ==================== 程序控制 ====================
    pub static void exit(int code) {
        _system_exit(code);
    }

    // ==================== 命令行参数 ====================
    pub static int argc() {
        return _GetCommandLineArgc();
    }

    pub static string argv(int index) {
        return _sys_argv_at(index);
    }

    pub static void printArgs() {
        int n = argc();
        print "argc = ", n, "\n";
        for int i = 0; i < n; ++i {
            print "argv[", i, "] = \"", argv(i), "\"\n";
        }
    }

    // ==================== 系统命令 ====================
    pub static int system(string cmd) {
        return _system_call(cmd);
    }

    // ==================== 时间 ====================
    pub static int time() {
        return _system_time();
    }

    pub static void sleep(int ms) {
        _system_sleep(ms);
    }

    // ==================== 环境变量 ====================
    pub static string env(string name) {
        return _system_getenv(name);
    }
}