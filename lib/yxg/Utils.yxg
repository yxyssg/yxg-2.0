// ============================================================
// yxg.Utils — 类型转换标准库
// 数值 ↔ 字符串的双向转换，包含异常包装层
// 注意：方法名不用 toString/toInt/toFloat，
//       因为 parser 把 .toString() 当作数组转字符串的语法糖。
// ============================================================

pub class ConvertError : ERROR {
    pub ConvertError(string msg) {
        this.info = msg;
    }
}

pub class Convert {

    // ==================== 数值 → 字符串 ====================

    // 有符号 32 位整数转字符串，正确处理 INT_MIN
    pub static string formatInt(int n) {
        if n == 0 { return "0"; }

        bool neg = n < 0;
        uint u;
        if neg {
            u = (0 - n) as uint;
        } else {
            u = n as uint;
        }

        char[12] buf;
        int len = 0;
        while u > 0 {
            int d = (u % 10) as int;
            buf[len] = (48 + d) as char;
            len = len + 1;
            u = u / 10;
        }

        string result = "";
        if neg { result = "-"; }

        int i = len - 1;
        while i >= 0 {
            result = result + _char_to_str(buf[i] as int);
            i = i - 1;
        }

        return result;
    }

    // 浮点数转字符串，指定小数位数
    pub static string formatFloat(float f, int precision) {
        if precision < 0 { precision = 0; }
        if precision > 9 { precision = 9; }

        if f == 0.0 {
            if precision == 0 { return "0"; }
            string z = "0.";
            for int i = 0; i < precision; i++ {
                z = z + "0";
            }
            return z;
        }

        bool neg = f < 0.0;
        if neg { f = -f; }

        int int_part = f as int;
        float frac = f - (int_part as float);

        string result = formatInt(int_part);

        if precision == 0 {
            if frac >= 0.5 {
                result = formatInt(int_part + 1);
            }
        } else {
            result = result + ".";
            for int i = 0; i < precision; i++ {
                frac = frac * 10.0;
                int d = frac as int;
                if d > 9 { d = 9; }
                if d < 0 { d = 0; }
                result = result + _char_to_str(48 + d);
                frac = frac - (d as float);
            }
        }

        if neg { result = "-" + result; }
        return result;
    }

    // 浮点数转字符串，默认 6 位小数
    pub static string formatFloat(float f) {
        return formatFloat(f, 6);
    }

    // ==================== 字符串 → 数值 ====================

    // 解析十进制整数，支持前导 '+' / '-'，失败抛异常
    pub static int parseInt(str s) {
        int n = s.length;
        if n == 0 { throw new ConvertError("empty string"); }

        int i = 0;
        int sign = 1;
        if s[0] == 45 {          // '-'
            sign = -1;
            i = 1;
        } else if s[0] == 43 {   // '+'
            i = 1;
        }
        if i >= n { throw new ConvertError("no digits"); }

        int result = 0;
        while i < n {
            int c = s[i];
            if c < 48 || c > 57 {
                throw new ConvertError("invalid character in number");
            }
            result = result * 10 + (c - 48);
            i = i + 1;
        }

        return result * sign;
    }

    // 解析十进制浮点数，支持可选的整数部分和小数部分
    pub static float parseFloat(str s) {
        int n = s.length;
        if n == 0 { throw new ConvertError("empty string"); }

        int i = 0;
        int sign = 1;
        if s[0] == 45 {
            sign = -1;
            i = 1;
        } else if s[0] == 43 {
            i = 1;
        }

        float int_part = 0.0;
        int int_digits = 0;
        while i < n {
            int c = s[i];
            if c < 48 || c > 57 { break; }
            int_part = int_part * 10.0 + ((c - 48) as float);
            int_digits = int_digits + 1;
            i = i + 1;
        }

        float frac_part = 0.0;
        int frac_digits = 0;
        if i < n && s[i] == 46 {   // '.'
            i = i + 1;
            float scale = 0.1;
            while i < n {
                int c = s[i];
                if c < 48 || c > 57 { break; }
                frac_part = frac_part + ((c - 48) as float) * scale;
                scale = scale * 0.1;
                i = i + 1;
                frac_digits = frac_digits + 1;
            }
        }

        if int_digits == 0 && frac_digits == 0 {
            throw new ConvertError("no digits");
        }

        if i < n {
            throw new ConvertError("trailing characters in number");
        }

        float total = int_part + frac_part;
        if sign < 0 { total = -total; }
        return total;
    }

    // ==================== 便捷别名 ====================

    pub static string intToStr(int n) {
        return formatInt(n);
    }

    pub static string floatToStr(float f) {
        return formatFloat(f, 6);
    }

    pub static string floatToStr(float f, int precision) {
        return formatFloat(f, precision);
    }

    pub static int    strToInt(str s) {
        return parseInt(s);
    }

    pub static float  strToFloat(str s) {
        return parseFloat(s);
    }

        // ==================== 数组数值转换 ====================

    pub static float[] toFloatArray(int[] a) {
        int n = a.length;
        float[] r = new float[n];
        for int i = 0; i < n; i++ {
            r[i] = a[i] as float;
        }
        return r;
    }

    pub static float[] toFloatArray(uint[] a) {
        int n = a.length;
        float[] r = new float[n];
        for int i = 0; i < n; i++ {
            r[i] = a[i] as float;
        }
        return r;
    }

    pub static float[] toFloatArray(int64[] a) {
        int n = a.length;
        float[] r = new float[n];
        for int i = 0; i < n; i++ {
            r[i] = a[i] as float;
        }
        return r;
    }

    pub static int[] toIntArray(float[] a) {
        int n = a.length;
        int[] r = new int[n];
        for int i = 0; i < n; i++ {
            r[i] = a[i] as int;
        }
        return r;
    }

    pub static int[] toIntArray(uint[] a) {
        int n = a.length;
        int[] r = new int[n];
        for int i = 0; i < n; i++ {
            r[i] = a[i] as int;
        }
        return r;
    }

    pub static int64[] toInt64Array(float[] a) {
        int n = a.length;
        int64[] r = new int64[n];
        for int i = 0; i < n; i++ {
            r[i] = a[i] as int64;
        }
        return r;
    }

    pub static uint[] toUIntArray(int[] a) {
        int n = a.length;
        uint[] r = new uint[n];
        for int i = 0; i < n; i++ {
            r[i] = a[i] as uint;
        }
        return r;
    }

        // ==================== int64 转换 ====================

    pub static int64 parseInt64(str s) {
        int n = s.length;
        if n == 0 { throw new ConvertError("empty string"); }
        int i = 0;
        int64 sign = 1;
        if s[0] == 45 { sign = 0 - 1; i = 1; }
        else if s[0] == 43 { i = 1; }
        if i >= n { throw new ConvertError("no digits"); }
        int64 result = 0;
        while i < n {
            int c = s[i];
            if c < 48 || c > 57 {
                throw new ConvertError("invalid character in number");
            }
            result = result * 10 + ((c - 48) as int64);
            i = i + 1;
        }
        return result * sign;
    }

    pub static string formatInt64(int64 n) {
        if n == 0 { return "0"; }
        bool neg = n < 0;
        int64 u = n;
        if neg { u = 0 - n; }
        char[24] buf;
        int len = 0;
        while u > 0 {
            int d = (u % 10) as int;
            buf[len] = (48 + d) as char;
            len = len + 1;
            u = u / 10;
        }
        string result = "";
        if neg { result = "-"; }
        int i = len - 1;
        while i >= 0 {
            result = result + _char_to_str(buf[i] as int);
            i = i - 1;
        }
        return result;
    }
}