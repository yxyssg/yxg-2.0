// yxg/Https.yxg -- HTTPS 客户端（2.5.3）
//
// 基于 Windows SChannel（secur32.dll）实现 TLS 客户端。
//
// 两层接口：
//   1) 底层 HttpsClient —— 面向连接的收发，接口模仿 yxg.Socket
//   2) 高层 HttpClient  —— 像 Http 模块那样「给 URL 拿响应」，内部处理分块传输
//
// 用法（高层）：
//   HttpClient http = new HttpClient();
//   HttpResult r = http.get("https://example.com/");
//   print r.status, " ", r.body, "\n";
//
// 用法（底层）：
//   HttpsClient c = new HttpsClient();
//   c.connect("example.com", 443);
//   c.send("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n");
//   string resp = c.recvAll(65536);
//   c.close();
//
// 注意：
//   - 只提供客户端，不做服务器端 TLS（服务器需要证书管理）
//   - 证书校验使用 SChannel 默认策略（会校验证书链）
//   - 依赖 secur32.dll，编译器检测到 _tls_* 调用会自动链接
//   - recv 单次最多读 16KB，大响应请用 recvAll

import yxg.Socket;
import yxg.String;
import yxg.Utils;

// ---- 原生层 ----
native int _tls_connect(int sock, string host);
native int _tls_write(int ctx, string data, int len);
native string _tls_read(int ctx, int maxlen);
native void _tls_close(int ctx);
native int _tls_last_error();
native int _tls_last_sec_status();

pub class HttpsError : ERROR {
    pub HttpsError(string msg) {
        this.info = msg;
    }
}

// ============================================================================
// 底层：面向连接的 TLS
// ============================================================================
pub class HttpsClient {
    pro Socket _sock;
    pro int _ctx;
    pro bool _connected;
    pro int _timeoutMs;

    pub HttpsClient() {
        this._sock = null;
        this._ctx = 0;
        this._connected = false;
        this._timeoutMs = 10000;
    }

    // 建立 TCP 连接并完成 TLS 握手
    //   返回 0=成功  -1=创建 socket 失败  -2=TCP 连接失败  -3=TLS 握手失败
    pub int connect(string host, int port) {
        if this._connected { this.close(); }

        this._sock = new Socket();
        int rc = this._sock.open(Socket_AF_INET, Socket_SOCK_STREAM, Socket_IPPROTO_TCP);
        if rc < 0 { return -1; }

        if this._timeoutMs > 0 { this._sock.setTimeout(this._timeoutMs); }

        rc = this._sock.connect(host, port);
        if rc != 0 {
            this._sock.close();
            this._sock = null;
            return -2;
        }

        this._ctx = _tls_connect(this._sock.handle(), host);
        if this._ctx == 0 {
            this._sock.close();
            this._sock = null;
            return -3;
        }
        this._connected = true;
        return 0;
    }

    pub bool isValid() {
        return this._connected;
    }

    pub void setTimeout(int ms) {
        this._timeoutMs = ms;
        if this._sock != null { this._sock.setTimeout(ms); }
    }

    // 发送明文（内部加密），返回发送字节数，失败返回 -1
    pub int send(string data) {
        if !this._connected { return -1; }
        int n = String.len(data);
        return _tls_write(this._ctx, data, n);
    }

    // 接收并解密，单次最多 16KB。返回空串表示对端关闭或失败
    pub string recv(int maxlen) {
        if !this._connected { return ""; }
        return _tls_read(this._ctx, maxlen);
    }

    // 循环接收直到对端关闭或达到 maxTotal
    // 注意：不解析 Content-Length，纯靠「读到 EOF」，适合 Connection: close
    pub string recvAll(int maxTotal) {
        if !this._connected { return ""; }
        string out = "";
        int total = 0;
        int guard = 0;
        while guard < 4096 {
            guard = guard + 1;
            int want = maxTotal - total;
            if want <= 0 { break; }
            if want > 16384 { want = 16384; }
            string piece = _tls_read(this._ctx, want);
            int n = String.len(piece);
            if n <= 0 { break; }
            out = out + piece;
            total = total + n;
            if n < want { break; }
        }
        return out;
    }

    // 一直读到响应头结束（遇到 \r\n\r\n），返回完整数据（含头）
    // 用于 keep-alive 场景，避免死等 EOF
    pub string recvHeaders() {
        if !this._connected { return ""; }
        string out = "";
        int guard = 0;
        while guard < 256 {
            guard = guard + 1;
            if String.indexOfStr(out, "\r\n\r\n") >= 0 { break; }
            string piece = _tls_read(this._ctx, 4096);
            int n = String.len(piece);
            if n <= 0 { break; }
            out = out + piece;
        }
        return out;
    }

    pub void close() {
        if this._ctx != 0 {
            _tls_close(this._ctx);
            this._ctx = 0;
        }
        if this._sock != null {
            this._sock.close();
            this._sock = null;
        }
        this._connected = false;
    }

    // 最近一次失败原因
    pub string lastError() {
        int e = _tls_last_error();
        if e == 0 { return "ok"; }
        if e == 1 { return "AcquireCredentialsHandle failed"; }
        if e == 2 { return "InitializeSecurityContext (initial) failed"; }
        if e == 3 { return "TLS handshake failed"; }
        if e == 4 { return "too many TLS connections"; }
        return "unknown error";
    }

    // SSPI 返回的原始状态码，排查问题时用
    pub int lastSecStatus() {
        return _tls_last_sec_status();
    }
}

// ============================================================================
// 高层：HTTP over TLS
// ============================================================================

// 一次请求的结果
pub class HttpResult {
    pub int status;          // HTTP 状态码，0 = 请求失败
    pub string headers;      // 原始响应头（含状态行）
    pub string body;         // 响应正文（已解 chunked）
    pub string error;        // 失败原因，成功时为空
    pub string[] headerLines;

    pub HttpResult() {
        this.status = 0;
        this.headers = "";
        this.body = "";
        this.error = "";
        this.headerLines = new string[0];
    }

    pub bool isOk() {
        return this.status == 200;
    }

    // 取某个响应头（大小写不敏感）
    pub string header(string name) {
        string want = String.toLowerStr(name);
        int i = 0;
        while i < this.headerLines.length {
            string line = this.headerLines[i];
            int colon = String.indexOfStr(line, ":");
            if colon > 0 {
                string k = String.sub(line, 0, colon);
                if String.toLowerStr(String.trim(k)) == want {
                    string v = String.sub(line, colon + 1,
                                          String.len(line) - colon - 1);
                    return String.trim(v);
                }
            }
            i = i + 1;
        }
        return "";
    }
}

pub class HttpClient {
    pro int _timeoutMs;

    pub HttpClient() {
        this._timeoutMs = 15000;
    }

    pub void setTimeout(int ms) {
        this._timeoutMs = ms;
    }

    // 发 GET 请求
    pub HttpResult get(string url) {
        return this.request("GET", url, "", "");
    }

    // 发 POST 请求（body 为原始字符串）
    pub HttpResult post(string url, string body, string contentType) {
        return this.request("POST", url, body, contentType);
    }

    // 通用请求
    pub HttpResult request(string method, string url,
                           string body, string contentType) {
        HttpResult result = new HttpResult();

        // ---- 解析 URL ----
        string rest = url;
        if String.startsWith(url, "https://") {
            rest = String.sub(url, 8, String.len(url) - 8);
        } else if String.startsWith(url, "http://") {
            result.error = "only https is supported";
            return result;
        } else {
            rest = url;
        }

        int slash = String.indexOfStr(rest, "/");
        string host = rest;
        string path = "/";
        if slash >= 0 {
            host = String.sub(rest, 0, slash);
            path = String.sub(rest, slash, String.len(rest) - slash);
        }

        int port = 443;
        int colon = String.indexOfStr(host, ":");
        if colon >= 0 {
            string ps = String.sub(host, colon + 1, String.len(host) - colon - 1);
            port = Convert.parseInt(ps);
            host = String.sub(host, 0, colon);
        }

        if String.len(host) == 0 {
            result.error = "empty host";
            return result;
        }

        // ---- 连接 ----
        HttpsClient c = new HttpsClient();
        c.setTimeout(this._timeoutMs);
        int rc = c.connect(host, port);
        if rc != 0 {
            result.error = c.lastError();
            c.close();
            return result;
        }

        // ---- 拼请求 ----
        string req = method + " " + path + " HTTP/1.1\r\n";
        req = req + "Host: " + host + "\r\n";
        req = req + "User-Agent: yxg/2.5.3\r\n";
        req = req + "Accept: */*\r\n";
        req = req + "Connection: close\r\n";
        if String.len(body) > 0 {
            req = req + "Content-Type: " + contentType + "\r\n";
            req = req + "Content-Length: " + Convert.formatInt(String.len(body)) + "\r\n";
        }
        req = req + "\r\n";
        if String.len(body) > 0 { req = req + body; }

        int sent = c.send(req);
        if sent <= 0 {
            result.error = "send failed";
            c.close();
            return result;
        }

        // ---- 收响应 ----
        string raw = c.recvAll(1048576);
        c.close();

        int n = String.len(raw);
        if n == 0 {
            result.error = "empty response";
            return result;
        }

        // 拆头与正文
        int sep = String.indexOfStr(raw, "\r\n\r\n");
        if sep < 0 {
            result.headers = raw;
            result.body = "";
        } else {
            result.headers = String.sub(raw, 0, sep);
            result.body = String.sub(raw, sep + 4, n - sep - 4);
        }

        // 解析状态码
        result.headerLines = String.split(result.headers, "\r\n");
        if result.headerLines.length > 0 {
            string statusLine = result.headerLines[0];
            string[] parts = String.split(statusLine, " ");
            if parts.length >= 2 {
                result.status = Convert.parseInt(parts[1]);
            }
        }

        // 解 chunked
        if String.toLowerStr(result.header("transfer-encoding")) == "chunked" {
            result.body = HttpClient.dechunk(result.body);
        }
        return result;
    }

    // 十六进制串转整数
    pub static int hexToInt(string s) {
        int n = 0;
        int i = 0;
        while i < String.len(s) {
            int ch = String.charAt(s, i);
            int v = -1;
            if ch >= 48 && ch <= 57 { v = ch - 48; }
            else if ch >= 97 && ch <= 102 { v = ch - 97 + 10; }
            else if ch >= 65 && ch <= 70 { v = ch - 65 + 10; }
            if v < 0 { break; }
            n = n * 16 + v;
            i = i + 1;
        }
        return n;
    }

    // 解分块传输编码
    pub static string dechunk(string s) {
        string out = "";
        int pos = 0;
        int n = String.len(s);
        int guard = 0;
        while pos < n && guard < 100000 {
            guard = guard + 1;
            string tail = String.sub(s, pos, n - pos);
            int rel = String.indexOfStr(tail, "\r\n");
            if rel < 0 { break; }
            int eol = pos + rel;
            string szhex = String.sub(s, pos, eol - pos);
            // 去掉分块扩展（; 之后的部分）
            int semi = String.indexOfStr(szhex, ";");
            if semi >= 0 { szhex = String.sub(szhex, 0, semi); }
            int sz = HttpClient.hexToInt(String.trim(szhex));
            if sz <= 0 { break; }
            int dstart = eol + 2;
            if dstart + sz > n { sz = n - dstart; }
            if sz <= 0 { break; }
            string chunk = String.sub(s, dstart, sz);
            out = out + chunk;
            pos = dstart + sz;
            // 跳过块尾的 \r\n
            if pos + 1 < n {
                string crlf = String.sub(s, pos, 2);
                if crlf == "\r\n" { pos = pos + 2; }
            }
        }
        return out;
    }
}
