// ============================================================
// yxg.String 标准库 — str 版本
// 所有方法均为 static，通过 String.xxx() 调用
// str 可同时接受 string、字面量、子串（编译器负责隐式转换）
// ============================================================

pub class String {

    // ==================== 基础信息 ====================
    pub static int len(str s) {
        return s.length;
    }

    pub static bool isEmpty(str s) {
        return s.length == 0;
    }

    // ==================== 字符访问 ====================
    pub static int charAt(str s, int index) {
        return s[index];
    }

    pub static int first(str s) {
        if s.length == 0 { return -1; }
        return s[0];
    }

    pub static int last(str s) {
        int n = s.length;
        if n == 0 { return -1; }
        return s[n - 1];
    }

    // ==================== 子串（返回 str 切片） ====================
    pub static str sub(str s, int start, int n) {
        if start < 0 { start = 0; }
        int total = s.length;
        if start >= total { return ""; }
        if n < 0 || start + n > total { n = total - start; }
        return s[start .. start + n];
    }

    pub static str left(str s, int n) {
        if n <= 0 { return ""; }
        int total = s.length;
        if n > total { n = total; }
        return s[0 .. n];
    }

    pub static str right(str s, int n) {
        if n <= 0 { return ""; }
        int total = s.length;
        if n > total { n = total; }
        return s[total - n .. total];
    }

    // ==================== 前后缀判断 ====================
    pub static bool startsWith(str s, str prefix) {
        int pLen = prefix.length;
        if pLen > s.length { return false; }
        for int i = 0; i < pLen; ++i {
            if s[i] != prefix[i] { return false; }
        }
        return true;
    }

    pub static bool endsWith(str s, str suffix) {
        int eLen = suffix.length;
        int sLen = s.length;
        if eLen > sLen { return false; }
        int off = sLen - eLen;
        for int i = 0; i < eLen; ++i {
            if s[off + i] != suffix[i] { return false; }
        }
        return true;
    }

    // ==================== 查找 ====================
    pub static int indexOf(str s, int ch) {
        int n = s.length;
        for int i = 0; i < n; ++i {
            if s[i] == ch { return i; }
        }
        return -1;
    }

    pub static int lastIndexOf(str s, int ch) {
        int n = s.length;
        int i = n - 1;
        while i >= 0 {
            if s[i] == ch { return i; }
            --i;
        }
        return -1;
    }

    pub static bool contains(str s, int ch) {
        return indexOf(s, ch) != -1;
    }

    pub static int indexOfStr(str s, str sub) {
        int sLen = s.length;
        int subLen = sub.length;
        if subLen > sLen { return -1; }
        if subLen == 0 { return 0; }
        int maxStart = sLen - subLen;
        for int i = 0; i <= maxStart; ++i {
            bool match = true;
            for int j = 0; j < subLen; ++j {
                if s[i + j] != sub[j] { match = false; break; }
            }
            if match { return i; }
        }
        return -1;
    }

    pub static bool containsStr(str s, str sub) {
        return indexOfStr(s, sub) != -1;
    }

    // ==================== 大小写转换（返回 string，因为需要分配） ====================
    pub static string toUpperStr(str s) {
        int n = s.length;
        string result = "";
        for int i = 0; i < n; ++i {
            int ch = s[i];
            if ch >= 97 && ch <= 122 { ch = ch - 32; }
            result = _str_plus_char(result, ch);
        }
        return result;
    }

    pub static string toLowerStr(str s) {
        int n = s.length;
        string result = "";
        for int i = 0; i < n; ++i {
            int ch = s[i];
            if ch >= 65 && ch <= 90 { ch = ch + 32; }
            result = _str_plus_char(result, ch);
        }
        return result;
    }

    // ==================== 空白处理（返回 str 切片） ====================
    pub static bool isSpace(int ch) {
        return ch == 32 || ch == 9 || ch == 10 || ch == 13;
    }

    pub static str trimL(str s) {
        int n = s.length;
        int start = 0;
        while start < n {
            if !isSpace(s[start]) { break; }
            ++start;
        }
        if start >= n { return ""; }
        return s[start .. n];
    }

    pub static str trimR(str s) {
        int n = s.length;
        int last = n - 1;
        while last >= 0 {
            if !isSpace(s[last]) { break; }
            --last;
        }
        if last < 0 { return ""; }
        return s[0 .. last + 1];
    }

    pub static str trim(str s) {
        return trimR(trimL(s));
    }

    // ==================== 重复与填充（返回 string） ====================
    pub static string repeat(str s, int count) {
        if count <= 0 { return ""; }
        string result = "";
        for int i = 0; i < count; ++i {
            result = result + s;
        }
        return result;
    }

    pub static string padL(str s, int total, int ch) {
        int n = s.length;
        if n >= total { return s; }
        string pad = "";
        for int i = 0; i < total - n; ++i {
            pad = _str_plus_char(pad, ch);
        }
        return pad + s;
    }

    pub static string padR(str s, int total, int ch) {
        int n = s.length;
        if n >= total { return s; }
        string pad = "";
        for int i = 0; i < total - n; ++i {
            pad = _str_plus_char(pad, ch);
        }
        return s + pad;
    }

    // ==================== 替换（返回 string） ====================
    pub static string replace(str s, str old, str newStr) {
        int sLen = s.length;
        int oldLen = old.length;
        if oldLen == 0 || oldLen > sLen { return s; }
        string result = "";
        int i = 0;
        while i < sLen {
            bool match = i + oldLen <= sLen;
            if match {
                for int j = 0; j < oldLen; ++j {
                    if s[i + j] != old[j] { match = false; break; }
                }
            }
            if match {
                result = result + newStr;
                i = i + oldLen;
            } else {
                result = _str_plus_char(result, s[i]);
                ++i;
            }
        }
        return result;
    }

    // ==================== 计数 ====================
    pub static int count(str s, int ch) {
        int n = 0;
        int len = s.length;
        for int i = 0; i < len; ++i {
            if s[i] == ch { ++n; }
        }
        return n;
    }

    pub static int countStr(str s, str sub) {
        int n = 0;
        int sLen = s.length;
        int subLen = sub.length;
        if subLen == 0 || subLen > sLen { return 0; }
        for int i = 0; i <= sLen - subLen; ++i {
            bool match = true;
            for int j = 0; j < subLen; ++j {
                if s[i + j] != sub[j] { match = false; break; }
            }
            if match { ++n; }
        }
        return n;
    }

    // ==================== 拆分（返回 string[]） ====================
    // 每个分段都物化为独立 GC string，不返回 str 视图（避免底层串被回收后悬空）
    pub static string[] split(str s, str sep) {
        int sLen = s.length;
        int sepLen = sep.length;
        // 空分隔符：逐字符拆分
        if sepLen == 0 {
            string[] chars = new string[sLen];
            for int i = 0; i < sLen; ++i {
                chars[i] = _char_to_str(s[i]);
            }
            return chars;
        }
        // 第一遍：统计分隔符个数
        int count = 0;
        int scan = 0;
        while scan <= sLen - sepLen {
            bool hit = true;
            for int k = 0; k < sepLen; ++k {
                if s[scan + k] != sep[k] { hit = false; break; }
            }
            if hit {
                ++count;
                scan = scan + sepLen;
            } else {
                ++scan;
            }
        }
        // 第二遍：切分并物化
        string[] result = new string[count + 1];
        int start = 0;
        int idx = 0;
        int cur = 0;
        while cur <= sLen - sepLen {
            bool hit = true;
            for int m = 0; m < sepLen; ++m {
                if s[cur + m] != sep[m] { hit = false; break; }
            }
            if hit {
                result[idx] = _str_to_string(String.sub(s, start, cur - start));
                ++idx;
                start = cur + sepLen;
                cur = start;
            } else {
                ++cur;
            }
        }
        result[idx] = _str_to_string(String.sub(s, start, sLen - start));
        return result;
    }
}