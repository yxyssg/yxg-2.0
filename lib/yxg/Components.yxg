pub class Com_Tool {
    // 颜色变暗 amount（0..255）
    pub int darken(int color, int amount) {
        int r = (color >> 16) & 0xFF;
        int g = (color >> 8) & 0xFF;
        int b = color & 0xFF;
        r = r - amount;
        g = g - amount;
        b = b - amount;
        if r < 0 { r = 0; }
        if g < 0 { g = 0; }
        if b < 0 { b = 0; }
        return (r << 16) | (g << 8) | b;
    }
    
    // 线性插值两个 0xRRGGBB 颜色，t 取 0..100
    pub static int lerp_color(int from, int to, int t) {
        int fr = (from >> 16) & 0xFF;
        int fg = (from >> 8) & 0xFF;
        int fb = from & 0xFF;
        int tr = (to >> 16) & 0xFF;
        int tg = (to >> 8) & 0xFF;
        int tb = to & 0xFF;
        int r = fr + (tr - fr) * t / 100;
        int g = fg + (tg - fg) * t / 100;
        int b = fb + (tb - fb) * t / 100;
        return (r << 16) | (g << 8) | b;
    }
}