// ---------- ComboBox 下拉框 ----------
class ComboBox {
    int handle;

    pub ComboBox() {
        handle = 0;
    }

    pub native int  create(Window parent, int x, int y, int w, int h);
    pub native void add_item(string item);
    pub native void clear_items();
    pub native int  get_selected();
    pub native void set_selected(int index);
    pub native string get_selected_text();
    pub native string get_item_text(int index);
    pub native int  is_changed();
    pub native void destroy();
    pub native void move(int x, int y);
    pub native void set_size(int w, int h);
    pub native void show();
    pub native void hide();
    pub native void owner_draw();
    pub virtual void onPaint(int dc, int x, int y, int w, int h, int state) {
        int itemID = (state >> 16) & 0xFFFF;
        int ods    = state & 0xFFFF;
        int bg = 0xFFFFFF;
        if ((ods & 1) != 0) {
            bg = 0x3399FF;
        }
        Window.dc_fill_rect(dc, x, y, w, h, bg);
        string text;
        if (itemID == 0xFFFF) {
            text = get_selected_text();
        } else {
            text = get_item_text(itemID);
        }
        Window.dc_draw_text(dc, x + 4, y + 3, text, 0x000000);
    }
}

// ---------- ListBox 列表框 ----------
class ListBox {
    int handle;

    pub ListBox() {
        handle = 0;
    }

    pub native int  create(Window parent, int x, int y, int w, int h);
    pub native void add_item(string item);
    pub native void clear_items();
    pub native int  get_selected();
    pub native void set_selected(int index);
    pub native string get_selected_text();
    pub native string get_item_text(int index);
    pub native int  is_changed();
    pub native void destroy();
    pub native void move(int x, int y);
    pub native void set_size(int w, int h);
    pub native void show();
    pub native void hide();
    pub native void owner_draw();
    pub virtual void onPaint(int dc, int x, int y, int w, int h, int state) {
        int itemID = (state >> 16) & 0xFFFF;
        int ods    = state & 0xFFFF;
        int bg = 0xFFFFFF;
        if ((ods & 1) != 0) {
            bg = 0x3399FF;
        }
        Window.dc_fill_rect(dc, x, y, w, h, bg);
        string text;
        if (itemID == 0xFFFF) {
            text = "";
        } else {
            text = get_item_text(itemID);
        }
        Window.dc_draw_text(dc, x + 4, y + 3, text, 0x000000);
    }
}

