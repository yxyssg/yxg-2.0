// ============================================================
// components.yxg — YXG 标准组件库
// Button(按钮) / TextBox(输入框) / Label(标签)
// 基于 Win32 子窗口, 需配合 runtime_window.asm
// ============================================================
import yxg.Window;

class Button {
    int handle;

    pub Button() {
        handle = 0;
    }

    pub native int  create(Window parent, string text, int x, int y, int w, int h);
    pub native void set_text(string text);
    pub native int  is_clicked();
    pub native void destroy();
    pub native void move(int x, int y);
    pub native void set_size(int w, int h);
    pub native void show();
    pub native void hide();
    pub native string get_text();
    pub native int  is_down();
    pub native int  is_hover();
    pub native int  has_focus();
    pub native void refresh();
    pub native void set_paint(void (*cb)(int dc, int x, int y, int w, int h, int state));
    pub native void owner_draw();
    pub virtual void onPaint(int dc, int x, int y, int w, int h, int state) {}
}

