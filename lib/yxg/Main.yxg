// import yxg.Socket;
import yxg.Utils;
import yxg.String;
import yxg.Math;
import yxg.Socket;
import Session;
import Http;

int g_listen_fd = 0;
SessionStore g_store;

pub string buffer_to_string(int buf, int len) {
    str s;
    unsafe int* p = &s as int*;
    p[0] = buf;
    p[1] = len;
    return _str_to_string(s);
}

pub void session_middleware(HttpRequest req, HttpResponse resp, SessionStore store) {
    string sid = req.getCookie("sid");
    Session sess = null;
    if String.len(sid) > 0 {
        sess = store.get(sid);
    }
    if sess == null {
        sess = store.create();
        resp.setCookieEx("sid", sess.sid, 3600);
    }
    req.session = sess;
    req.has_session = true;
}

pub void handle_request(HttpRequest req, HttpResponse resp) {
    string p = req.path;

    if p == "/hello" {
        string name = req.getQuery("name");
        if String.len(name) == 0 {
            name = "world";
        }
        resp.write("hello, " + name);
        return;
    }

    if p == "/test1" || p == "/test2" || p == "/a" || p == "/b" {
        resp.write("hello, session " + req.session.sid);
        return;
    }

    if p == "/login" {
        string user = req.getQuery("user");
        if String.len(user) == 0 {
            user = "anonymous";
        }
        req.session.set("user", user);
        resp.write("logged in as " + user);
        return;
    }

    if p == "/whoami" {
        if req.session.data.has("user") {
            resp.write("user=" + req.session.get("user"));
        } else {
            resp.write("not logged in");
        }
        return;
    }

    if p == "/logout" {
        req.session.remove("user");
        resp.write("logged out");
        return;
    }

    resp.status = 404;
    resp.write("not found: " + p);
}

pub int on_accept(int ov, int bytes, int status) {
    if status != 0 {
        Iocp.accept_async(g_listen_fd, &on_accept);
        return 0;
    }
    int peer_fd = Iocp.ov_get_fd(ov);
    Iocp.recv_async(peer_fd, 4096, &on_recv);
    Iocp.accept_async(g_listen_fd, &on_accept);
    return 1;
}

pub int on_recv(int ov, int bytes, int status) {
    int peer_fd = Iocp.ov_get_fd(ov);
    int buf = Iocp.ov_get_buffer(ov);
    if status != 0 || bytes == 0 {
        _socket_close(peer_fd);
        return 0;
    }

    string raw = buffer_to_string(buf, bytes);
    HttpRequest req = HttpRequest.parse(raw);
    HttpResponse resp = new HttpResponse();

    session_middleware(req, resp, g_store);
    handle_request(req, resp);

    string wire = resp.build();
    _socket_send(peer_fd, wire, String.len(wire));
    _socket_close(peer_fd);
    return 1;
}

pub int on_dispatch(int ov, int bytes, int status) {
    return 1;
}

pub void main() {
    Math.srand(_system_time());

    g_store = new SessionStore(3600, 10000);

    if Iocp.init() == 0 {
        print "IOCP init failed\n";
        return;
    }
    int lfd = _socket_create(2, 1, 6);
    if lfd < 0 {
        print "socket failed\n";
        return;
    }
    _socket_set_reuseaddr(lfd, 1);
    if _socket_bind(lfd, 9999) < 0 {
        print "bind failed\n";
        return;
    }
    _socket_listen(lfd, 128);
    g_listen_fd = lfd;
    Iocp.associate(lfd, 0);
    Iocp.start_worker(&on_dispatch);
    Iocp.accept_async(lfd, &on_accept);
    print "IOCP listening on :9999\n";

    int gc_tick = 0;
    while 1 == 1 {
        _thread_sleep(1000);
        gc_tick = gc_tick + 1;
        if gc_tick >= 60 {
            g_store.gc();
            gc_tick = 0;
        }
    }
}