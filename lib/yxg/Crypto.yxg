// yxg/Crypto.yxg -- hashing & encoding helpers (2.5.2)
//
// 目前提供：
//   Base64 编码 / 解码
//   十六进制转换
//   MD5 / SHA256
//
// 实现说明：YXG 里「字符码 -> 字符串」不可靠（"" + char 会生成错误汇编），
// 所以所有输出都通过查表得到：B64CH / HEXCH 是 string[] 常量表。
// 数组元素参与字符串拼接是安全的。

import yxg.String;

class Crypto {
    // ---------- 查表 ----------

    // Base64 字母表
    pri static string[] b64chars() {
        string[] t = new string[64];
        t[0] = "A";  t[1] = "B";  t[2] = "C";  t[3] = "D";
        t[4] = "E";  t[5] = "F";  t[6] = "G";  t[7] = "H";
        t[8] = "I";  t[9] = "J";  t[10] = "K"; t[11] = "L";
        t[12] = "M"; t[13] = "N"; t[14] = "O"; t[15] = "P";
        t[16] = "Q"; t[17] = "R"; t[18] = "S"; t[19] = "T";
        t[20] = "U"; t[21] = "V"; t[22] = "W"; t[23] = "X";
        t[24] = "Y"; t[25] = "Z";
        t[26] = "a"; t[27] = "b"; t[28] = "c"; t[29] = "d";
        t[30] = "e"; t[31] = "f"; t[32] = "g"; t[33] = "h";
        t[34] = "i"; t[35] = "j"; t[36] = "k"; t[37] = "l";
        t[38] = "m"; t[39] = "n"; t[40] = "o"; t[41] = "p";
        t[42] = "q"; t[43] = "r"; t[44] = "s"; t[45] = "t";
        t[46] = "u"; t[47] = "v"; t[48] = "w"; t[49] = "x";
        t[50] = "y"; t[51] = "z";
        t[52] = "0"; t[53] = "1"; t[54] = "2"; t[55] = "3";
        t[56] = "4"; t[57] = "5"; t[58] = "6"; t[59] = "7";
        t[60] = "8"; t[61] = "9";
        t[62] = "+"; t[63] = "/";
        return t;
    }

    // 十六进制字母表
    pri static string[] hexChars() {
        string[] t = new string[16];
        t[0] = "0"; t[1] = "1"; t[2] = "2"; t[3] = "3";
        t[4] = "4"; t[5] = "5"; t[6] = "6"; t[7] = "7";
        t[8] = "8"; t[9] = "9"; t[10] = "a"; t[11] = "b";
        t[12] = "c"; t[13] = "d"; t[14] = "e"; t[15] = "f";
        return t;
    }

    // 字节 -> 两位十六进制
    pub static string toHexByte(int b) {
        string[] h = hexChars();
        int hi = (b / 16) & 15;
        int lo = b & 15;
        string a = h[hi];
        string c = h[lo];
        return a + c;
    }

    // 字节数组（用 string 承载）-> 十六进制串
    pub static string toHex(string data) {
        int n = String.len(data);
        string r = "";
        int i = 0;
        while i < n {
            int b = String.charAt(data, i) & 255;
            string hx = toHexByte(b);
            r = r + hx;
            i = i + 1;
        }
        return r;
    }

    // ---------- Base64 ----------

    // 编码：输入原串，输出 Base64 文本
    pub static string base64Encode(string data) {
        string[] b = b64chars();
        int n = String.len(data);
        string r = "";
        int i = 0;
        while i < n {
            int b0 = String.charAt(data, i) & 255;
            int b1 = 0;
            int b2 = 0;
            bool has1 = (i + 1 < n);
            bool has2 = (i + 2 < n);
            if has1 { b1 = String.charAt(data, i + 1) & 255; }
            if has2 { b2 = String.charAt(data, i + 2) & 255; }

            int c0 = b0 >> 2;
            int c1 = ((b0 & 3) << 4) | (b1 >> 4);
            int c2 = ((b1 & 15) << 2) | (b2 >> 6);
            int c3 = b2 & 63;

            string p0 = b[c0];
            string p1 = b[c1];
            r = r + p0 + p1;
            if has1 {
                string p2 = b[c2];
                r = r + p2;
            } else {
                r = r + "=";
            }
            if has2 {
                string p3 = b[c3];
                r = r + p3;
            } else {
                r = r + "=";
            }

            if has2 { i = i + 3; }
            else if has1 { i = i + 2; }
            else { i = i + 1; }
        }
        return r;
    }

    // 一个 Base64 字符转回 0..63，非法返回 -1
    pub static int base64Value(int ch) {
        if ch >= 65 && ch <= 90 { return ch - 65; }          // A-Z
        if ch >= 97 && ch <= 122 { return ch - 97 + 26; }    // a-z
        if ch >= 48 && ch <= 57 { return ch - 48 + 52; }     // 0-9
        if ch == 43 { return 62; }                            // '+'
        if ch == 47 { return 63; }                            // '/'
        return -1;
    }

    // 解码：忽略 '='、换行与空格，非法字符跳过。
    // 返回的是十六进制形式（YXG 目前无法把字节码拼成字符串，
    // 见 repro/BugCharToString.yxg），例如 "SGVsbG8=" -> "48656c6c6f"。
    pub static string base64Decode(string b64) {
        int n = String.len(b64);
        int acc = 0;
        int accBits = 0;
        string r = "";

        int i = 0;
        while i < n {
            int ch = String.charAt(b64, i);
            i = i + 1;
            if ch == 61 { continue; }                 // '='
            if ch == 10 || ch == 13 || ch == 32 { continue; }
            int v = base64Value(ch);
            if v < 0 { continue; }

            acc = (acc << 6) | v;
            accBits = accBits + 6;
            if accBits >= 8 {
                accBits = accBits - 8;
                int byt = (acc >> accBits) & 255;
                string hx = toHexByte(byt);
                r = r + hx;
            }
        }
        return r;
    }

    // 十六进制串 -> 原串（用于把 base64Decode 的结果转回文本）
    pub static string hexToText(string hex) {
        int n = String.len(hex);
        string r = "";
        int i = 0;
        while i + 1 < n {
            int hi = hexVal(String.charAt(hex, i));
            int lo = hexVal(String.charAt(hex, i + 1));
            if hi >= 0 && lo >= 0 {
                int byt = hi * 16 + lo;
                // 只还原可打印 ASCII，其余用 '.' 占位
                if byt >= 32 && byt < 127 {
                    string part = asciiChar(byt);
                    r = r + part;
                } else {
                    r = r + ".";
                }
            }
            i = i + 2;
        }
        return r;
    }

    pri static int hexVal(int ch) {
        if ch >= 48 && ch <= 57 { return ch - 48; }
        if ch >= 97 && ch <= 102 { return ch - 97 + 10; }
        if ch >= 65 && ch <= 70 { return ch - 65 + 10; }
        return -1;
    }

    // 把 32..126 的 ASCII 码变成单字符字符串（用查表绕开 "" + char 的生成 bug）
    pri static string asciiChar(int code) {
        string[] t = new string[95];
        int k = 32;
        while k < 127 {
            t[k - 32] = asciiAt(k);
            k = k + 1;
        }
        return t[code - 32];
    }

    pri static string asciiAt(int code) {
        if code == 32 { return " "; }
        if code == 33 { return "!"; }
        if code == 34 { return "\""; }
        if code == 35 { return "#"; }
        if code == 36 { return "$"; }
        if code == 37 { return "%"; }
        if code == 38 { return "&"; }
        if code == 39 { return "'"; }
        if code == 40 { return "("; }
        if code == 41 { return ")"; }
        if code == 42 { return "*"; }
        if code == 43 { return "+"; }
        if code == 44 { return ","; }
        if code == 45 { return "-"; }
        if code == 46 { return "."; }
        if code == 47 { return "/"; }
        if code == 58 { return ":"; }
        if code == 59 { return ";"; }
        if code == 60 { return "<"; }
        if code == 61 { return "="; }
        if code == 62 { return ">"; }
        if code == 63 { return "?"; }
        if code == 64 { return "@"; }
        if code == 91 { return "["; }
        if code == 92 { return "\\"; }
        if code == 93 { return "]"; }
        if code == 94 { return "^"; }
        if code == 95 { return "_"; }
        if code == 96 { return "`"; }
        if code == 123 { return "{"; }
        if code == 124 { return "|"; }
        if code == 125 { return "}"; }
        if code == 126 { return "~"; }
        // 数字
        if code >= 48 && code <= 57 { return digitStr(code - 48); }
        // 大写
        if code >= 65 && code <= 90 { return upperStr(code - 65); }
        // 小写
        if code >= 97 && code <= 122 { return lowerStr(code - 97); }
        return ".";
    }

    pri static string digitStr(int i) {
        string[] t = new string[10];
        t[0] = "0"; t[1] = "1"; t[2] = "2"; t[3] = "3"; t[4] = "4";
        t[5] = "5"; t[6] = "6"; t[7] = "7"; t[8] = "8"; t[9] = "9";
        return t[i];
    }

    pri static string upperStr(int i) {
        string[] t = new string[26];
        t[0]="A"; t[1]="B"; t[2]="C"; t[3]="D"; t[4]="E"; t[5]="F"; t[6]="G";
        t[7]="H"; t[8]="I"; t[9]="J"; t[10]="K"; t[11]="L"; t[12]="M";
        t[13]="N"; t[14]="O"; t[15]="P"; t[16]="Q"; t[17]="R"; t[18]="S";
        t[19]="T"; t[20]="U"; t[21]="V"; t[22]="W"; t[23]="X"; t[24]="Y"; t[25]="Z";
        return t[i];
    }

    pri static string lowerStr(int i) {
        string[] t = new string[26];
        t[0]="a"; t[1]="b"; t[2]="c"; t[3]="d"; t[4]="e"; t[5]="f"; t[6]="g";
        t[7]="h"; t[8]="i"; t[9]="j"; t[10]="k"; t[11]="l"; t[12]="m";
        t[13]="n"; t[14]="o"; t[15]="p"; t[16]="q"; t[17]="r"; t[18]="s";
        t[19]="t"; t[20]="u"; t[21]="v"; t[22]="w"; t[23]="x"; t[24]="y"; t[25]="z";
        return t[i];
    }

    // ---------- MD5 ----------

    pri static uint md5Rotl(uint x, int n) {
        uint a = x << n;
        uint lo = x >> (32 - n);
        return a | lo;
    }

    // MD5 常量表 K[i] = floor(abs(sin(i+1)) * 2^32)
    pri static uint md5K(int i) {
        uint[] t = new uint[64];
        t[0]=0xd76aa478; t[1]=0xe8c7b756; t[2]=0x242070db; t[3]=0xc1bdceee;
        t[4]=0xf57c0faf; t[5]=0x4787c62a; t[6]=0xa8304613; t[7]=0xfd469501;
        t[8]=0x698098d8; t[9]=0x8b44f7af; t[10]=0xffff5bb1; t[11]=0x895cd7be;
        t[12]=0x6b901122; t[13]=0xfd987193; t[14]=0xa679438e; t[15]=0x49b40821;
        t[16]=0xf61e2562; t[17]=0xc040b340; t[18]=0x265e5a51; t[19]=0xe9b6c7aa;
        t[20]=0xd62f105d; t[21]=0x02441453; t[22]=0xd8a1e681; t[23]=0xe7d3fbc8;
        t[24]=0x21e1cde6; t[25]=0xc33707d6; t[26]=0xf4d50d87; t[27]=0x455a14ed;
        t[28]=0xa9e3e905; t[29]=0xfcefa3f8; t[30]=0x676f02d9; t[31]=0x8d2a4c8a;
        t[32]=0xfffa3942; t[33]=0x8771f681; t[34]=0x6d9d6122; t[35]=0xfde5380c;
        t[36]=0xa4beea44; t[37]=0x4bdecfa9; t[38]=0xf6bb4b60; t[39]=0xbebfbc70;
        t[40]=0x289b7ec6; t[41]=0xeaa127fa; t[42]=0xd4ef3085; t[43]=0x04881d05;
        t[44]=0xd9d4d039; t[45]=0xe6db99e5; t[46]=0x1fa27cf8; t[47]=0xc4ac5665;
        t[48]=0xf4292244; t[49]=0x432aff97; t[50]=0xab9423a7; t[51]=0xfc93a039;
        t[52]=0x655b59c3; t[53]=0x8f0ccc92; t[54]=0xffeff47d; t[55]=0x85845dd1;
        t[56]=0x6fa87e4f; t[57]=0xfe2ce6e0; t[58]=0xa3014314; t[59]=0x4e0811a1;
        t[60]=0xf7537e82; t[61]=0xbd3af235; t[62]=0x2ad7d2bb; t[63]=0xeb86d391;
        return t[i];
    }

    // 每轮的左移位数
    pri static int md5Shift(int i) {
        int[] t = new int[64];
        t[0]=7;  t[1]=12; t[2]=17; t[3]=22;
        t[4]=7;  t[5]=12; t[6]=17; t[7]=22;
        t[8]=7;  t[9]=12; t[10]=17; t[11]=22;
        t[12]=7; t[13]=12; t[14]=17; t[15]=22;
        t[16]=5; t[17]=9; t[18]=14; t[19]=20;
        t[20]=5; t[21]=9; t[22]=14; t[23]=20;
        t[24]=5; t[25]=9; t[26]=14; t[27]=20;
        t[28]=5; t[29]=9; t[30]=14; t[31]=20;
        t[32]=4; t[33]=11; t[34]=16; t[35]=23;
        t[36]=4; t[37]=11; t[38]=16; t[39]=23;
        t[40]=4; t[41]=11; t[42]=16; t[43]=23;
        t[44]=4; t[45]=11; t[46]=16; t[47]=23;
        t[48]=6; t[49]=10; t[50]=15; t[51]=21;
        t[52]=6; t[53]=10; t[54]=15; t[55]=21;
        t[56]=6; t[57]=10; t[58]=15; t[59]=21;
        t[60]=6; t[61]=10; t[62]=15; t[63]=21;
        return t[i];
    }

    // 32 位小端字节 -> uint
    pri static uint le32(int b0, int b1, int b2, int b3) {
        uint v = 0;
        v = v | (b0 & 255);
        v = v | ((b1 & 255) << 8);
        v = v | ((b2 & 255) << 16);
        v = v | ((b3 & 255) << 24);
        return v;
    }

    // 把 uint 的字节（小端）追加到十六进制串
    pri static string uintToHexLE(uint v) {
        string[] h = hexChars();
        int b0 = v & 255;
        int b1 = (v >> 8) & 255;
        int b2 = (v >> 16) & 255;
        int b3 = (v >> 24) & 255;
        string s0 = h[b0 / 16];
        string s1 = h[b0 & 15];
        string s2 = h[b1 / 16];
        string s3 = h[b1 & 15];
        string s4 = h[b2 / 16];
        string s5 = h[b2 & 15];
        string s6 = h[b3 / 16];
        string s7 = h[b3 & 15];
        string r = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7;
        return r;
    }

    // MD5 摘要（小写十六进制）。输入上限 4000 字节。
    pub static string md5(string data) {
        int n = String.len(data);
        if n > 4000 { n = 4000; }

        // 组装填充后的字节
        int[] buf = new int[4096];
        int i = 0;
        while i < n {
            buf[i] = String.charAt(data, i) & 255;
            i = i + 1;
        }
        buf[n] = 128;
        int total = n + 1;
        while total % 64 != 56 {
            buf[total] = 0;
            total = total + 1;
        }
        // 64 位长度的小端表示（只写低 32 位，高位补 0）
        uint bitLenLo = n * 8;
        buf[total] = bitLenLo & 255;
        buf[total + 1] = (bitLenLo >> 8) & 255;
        buf[total + 2] = (bitLenLo >> 16) & 255;
        buf[total + 3] = (bitLenLo >> 24) & 255;
        buf[total + 4] = 0;
        buf[total + 5] = 0;
        buf[total + 6] = 0;
        buf[total + 7] = 0;
        int padded = total + 8;

        uint a0 = 0x67452301;
        uint b0 = 0xefcdab89;
        uint c0 = 0x98badcfe;
        uint d0 = 0x10325476;

        int blk = 0;
        while blk < padded {
            uint[] m = new uint[16];
            int k = 0;
            while k < 16 {
                int off = blk + k * 4;
                m[k] = le32(buf[off], buf[off + 1], buf[off + 2], buf[off + 3]);
                k = k + 1;
            }

            uint A = a0;
            uint B = b0;
            uint C = c0;
            uint D = d0;

            int r = 0;
            while r < 64 {
                uint f = 0;
                int g = 0;
                if r < 16 {
                    f = (B & C) | ((4294967295 ^ B) & D);
                    g = r;
                } else if r < 32 {
                    f = (D & B) | ((4294967295 ^ D) & C);
                    g = (5 * r + 1) & 15;
                } else if r < 48 {
                    f = B ^ C ^ D;
                    g = (3 * r + 5) & 15;
                } else {
                    f = C ^ (B | (4294967295 ^ D));
                    g = (7 * r) & 15;
                }

                uint kv = md5K(r);
                uint mv = m[g];
                uint sum = f + A + kv + mv;
                int sh = md5Shift(r);
                uint rot = md5Rotl(sum, sh);
                uint nb = B + rot;

                A = D;
                D = C;
                C = B;
                B = nb;
                r = r + 1;
            }

            a0 = a0 + A;
            b0 = b0 + B;
            c0 = c0 + C;
            d0 = d0 + D;
            blk = blk + 64;
        }

        string h0 = uintToHexLE(a0);
        string h1 = uintToHexLE(b0);
        string h2 = uintToHexLE(c0);
        string h3 = uintToHexLE(d0);
        string out = h0 + h1 + h2 + h3;
        return out;
    }

    // ---------- SHA256 ----------

    pri static uint shaRotr(uint x, int n) {
        uint hi = x >> n;
        uint lo = x << (32 - n);
        return hi | lo;
    }

    pri static uint shaK(int i) {
        uint[] t = new uint[64];
        t[0]=0x428a2f98; t[1]=0x71374491; t[2]=0xb5c0fbcf; t[3]=0xe9b5dba5;
        t[4]=0x3956c25b; t[5]=0x59f111f1; t[6]=0x923f82a4; t[7]=0xab1c5ed5;
        t[8]=0xd807aa98; t[9]=0x12835b01; t[10]=0x243185be; t[11]=0x550c7dc3;
        t[12]=0x72be5d74; t[13]=0x80deb1fe; t[14]=0x9bdc06a7; t[15]=0xc19bf174;
        t[16]=0xe49b69c1; t[17]=0xefbe4786; t[18]=0x0fc19dc6; t[19]=0x240ca1cc;
        t[20]=0x2de92c6f; t[21]=0x4a7484aa; t[22]=0x5cb0a9dc; t[23]=0x76f988da;
        t[24]=0x983e5152; t[25]=0xa831c66d; t[26]=0xb00327c8; t[27]=0xbf597fc7;
        t[28]=0xc6e00bf3; t[29]=0xd5a79147; t[30]=0x06ca6351; t[31]=0x14292967;
        t[32]=0x27b70a85; t[33]=0x2e1b2138; t[34]=0x4d2c6dfc; t[35]=0x53380d13;
        t[36]=0x650a7354; t[37]=0x766a0abb; t[38]=0x81c2c92e; t[39]=0x92722c85;
        t[40]=0xa2bfe8a1; t[41]=0xa81a664b; t[42]=0xc24b8b70; t[43]=0xc76c51a3;
        t[44]=0xd192e819; t[45]=0xd6990624; t[46]=0xf40e3585; t[47]=0x106aa070;
        t[48]=0x19a4c116; t[49]=0x1e376c08; t[50]=0x2748774c; t[51]=0x34b0bcb5;
        t[52]=0x391c0cb3; t[53]=0x4ed8aa4a; t[54]=0x5b9cca4f; t[55]=0x682e6ff3;
        t[56]=0x748f82ee; t[57]=0x78a5636f; t[58]=0x84c87814; t[59]=0x8cc70208;
        t[60]=0x90befffa; t[61]=0xa4506ceb; t[62]=0xbef9a3f7; t[63]=0xc67178f2;
        return t[i];
    }

    pri static uint be32(int b0, int b1, int b2, int b3) {
        uint v = 0;
        v = v | ((b0 & 255) << 24);
        v = v | ((b1 & 255) << 16);
        v = v | ((b2 & 255) << 8);
        v = v | (b3 & 255);
        return v;
    }

    pri static string uintToHexBE(uint v) {
        string[] h = hexChars();
        int b0 = (v >> 24) & 255;
        int b1 = (v >> 16) & 255;
        int b2 = (v >> 8) & 255;
        int b3 = v & 255;
        string s0 = h[b0 / 16];
        string s1 = h[b0 & 15];
        string s2 = h[b1 / 16];
        string s3 = h[b1 & 15];
        string s4 = h[b2 / 16];
        string s5 = h[b2 & 15];
        string s6 = h[b3 / 16];
        string s7 = h[b3 & 15];
        string r = s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7;
        return r;
    }

    // SHA-256 摘要（小写十六进制）。输入上限 4000 字节。
    pub static string sha256(string data) {
        int n = String.len(data);
        if n > 4000 { n = 4000; }

        int[] buf = new int[4096];
        int i = 0;
        while i < n {
            buf[i] = String.charAt(data, i) & 255;
            i = i + 1;
        }
        buf[n] = 128;
        int total = n + 1;
        while total % 64 != 56 {
            buf[total] = 0;
            total = total + 1;
        }
        // 大端 64 位长度（高位 0）
        uint bitLen = n * 8;
        buf[total]     = 0;
        buf[total + 1] = 0;
        buf[total + 2] = 0;
        buf[total + 3] = 0;
        buf[total + 4] = (bitLen >> 24) & 255;
        buf[total + 5] = (bitLen >> 16) & 255;
        buf[total + 6] = (bitLen >> 8) & 255;
        buf[total + 7] = bitLen & 255;
        int padded = total + 8;

        uint h0 = 0x6a09e667;
        uint h1 = 0xbb67ae85;
        uint h2 = 0x3c6ef372;
        uint h3 = 0xa54ff53a;
        uint h4 = 0x510e527f;
        uint h5 = 0x9b05688c;
        uint h6 = 0x1f83d9ab;
        uint h7 = 0x5be0cd19;

        int blk = 0;
        while blk < padded {
            uint[] w = new uint[64];
            int k = 0;
            while k < 16 {
                int off = blk + k * 4;
                w[k] = be32(buf[off], buf[off + 1], buf[off + 2], buf[off + 3]);
                k = k + 1;
            }
            k = 16;
            while k < 64 {
                uint s0 = shaRotr(w[k - 15], 7) ^ shaRotr(w[k - 15], 18) ^ (w[k - 15] >> 3);
                uint s1 = shaRotr(w[k - 2], 17) ^ shaRotr(w[k - 2], 19) ^ (w[k - 2] >> 10);
                uint val = w[k - 16] + s0 + w[k - 7] + s1;
                w[k] = val;
                k = k + 1;
            }

            uint A = h0;
            uint B = h1;
            uint C = h2;
            uint D = h3;
            uint E = h4;
            uint F = h5;
            uint G = h6;
            uint H = h7;

            int r = 0;
            while r < 64 {
                uint S1 = shaRotr(E, 6) ^ shaRotr(E, 11) ^ shaRotr(E, 25);
                uint ch = (E & F) ^ ((4294967295 ^ E) & G);
                uint temp1 = H + S1 + ch + shaK(r) + w[r];
                uint S0 = shaRotr(A, 2) ^ shaRotr(A, 13) ^ shaRotr(A, 22);
                uint maj = (A & B) ^ (A & C) ^ (B & C);
                uint temp2 = S0 + maj;

                H = G;
                G = F;
                F = E;
                E = D + temp1;
                D = C;
                C = B;
                B = A;
                A = temp1 + temp2;
                r = r + 1;
            }

            h0 = h0 + A;
            h1 = h1 + B;
            h2 = h2 + C;
            h3 = h3 + D;
            h4 = h4 + E;
            h5 = h5 + F;
            h6 = h6 + G;
            h7 = h7 + H;
            blk = blk + 64;
        }

        string r0 = uintToHexBE(h0);
        string r1 = uintToHexBE(h1);
        string r2 = uintToHexBE(h2);
        string r3 = uintToHexBE(h3);
        string r4 = uintToHexBE(h4);
        string r5 = uintToHexBE(h5);
        string r6 = uintToHexBE(h6);
        string r7 = uintToHexBE(h7);
        string out = r0 + r1 + r2 + r3 + r4 + r5 + r6 + r7;
        return out;
    }
}