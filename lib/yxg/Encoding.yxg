// yxg/Encoding.yxg -- text encoding conversion (2.5.2)
//
// 提供 UTF-8 与 UTF-16LE 的互转，以及码点计数。
// 纯 YXG 实现，不依赖系统 API（除了后面单独的 GBK 部分）。
//
// 约定：字符串在 YXG 里是字节序列，本模块把「UTF-16LE」也当作字节序列处理，
// 每个 UTF-16 码元写两个字节（低字节在前）。

import yxg.String;

// GBK(936) <-> UTF-8(65001)，实现在 runtime_ffi.asm
pub native string _yxg_gbk_to_utf8(string gbk, int len);
pub native string _yxg_utf8_to_gbk(string utf8, int len);





class Encoding {
    // ---------- 内部：单个字节拼成字符串 ----------

    pri static string byteStr(int b) {
        char c = b & 255;
        string s = "" + c;
        return s;
    }

    // 追加一个 UTF-16 码元（小端两字节）
    pri static string appendU16(string acc, int unit) {
        string lo = byteStr(unit & 255);
        string hi = byteStr((unit >> 8) & 255);
        string r = acc + lo + hi;
        return r;
    }

    // 追加一个 UTF-8 码点
    pri static string appendUtf8(string acc, int cp) {
        string r = acc;
        if cp < 128 {
            r = r + byteStr(cp);
        } else if cp < 2048 {
            r = r + byteStr(192 | (cp >> 6));
            r = r + byteStr(128 | (cp & 63));
        } else if cp < 65536 {
            r = r + byteStr(224 | (cp >> 12));
            r = r + byteStr(128 | ((cp >> 6) & 63));
            r = r + byteStr(128 | (cp & 63));
        } else {
            r = r + byteStr(240 | (cp >> 18));
            r = r + byteStr(128 | ((cp >> 12) & 63));
            r = r + byteStr(128 | ((cp >> 6) & 63));
            r = r + byteStr(128 | (cp & 63));
        }
        return r;
    }

    // ---------- UTF-8 -> UTF-16LE ----------

    pub static string utf8ToUtf16(string s) {
        int n = String.len(s);
        string r = "";
        int i = 0;
        while i < n {
            int b0 = String.charAt(s, i) & 255;
            int cp = 0;
            int used = 1;
            if b0 < 128 {
                cp = b0;
                used = 1;
            } else if b0 >= 192 && b0 < 224 {
                int b1 = 0;
                if i + 1 < n { b1 = String.charAt(s, i + 1) & 255; }
                cp = ((b0 & 31) << 6) | (b1 & 63);
                used = 2;
            } else if b0 >= 224 && b0 < 240 {
                int b1 = 0;
                int b2 = 0;
                if i + 1 < n { b1 = String.charAt(s, i + 1) & 255; }
                if i + 2 < n { b2 = String.charAt(s, i + 2) & 255; }
                cp = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
                used = 3;
            } else if b0 >= 240 {
                int b1 = 0;
                int b2 = 0;
                int b3 = 0;
                if i + 1 < n { b1 = String.charAt(s, i + 1) & 255; }
                if i + 2 < n { b2 = String.charAt(s, i + 2) & 255; }
                if i + 3 < n { b3 = String.charAt(s, i + 3) & 255; }
                cp = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
                used = 4;
            } else {
                // 非法起始字节，按 1 字节跳过
                cp = 63;
                used = 1;
            }

            if cp < 65536 {
                r = appendU16(r, cp);
            } else {
                int v = cp - 65536;
                int hiSur = 55296 + (v >> 10);
                int loSur = 56320 + (v & 1023);
                r = appendU16(r, hiSur);
                r = appendU16(r, loSur);
            }
            i = i + used;
        }
        return r;
    }

    // ---------- UTF-16LE -> UTF-8 ----------

    pub static string utf16ToUtf8(string s) {
        int n = String.len(s);
        string r = "";
        int i = 0;
        while i + 1 < n {
            int lo = String.charAt(s, i) & 255;
            int hi = String.charAt(s, i + 1) & 255;
            int unit = lo | (hi << 8);
            i = i + 2;

            int cp = unit;
            if unit >= 55296 && unit <= 56319 && i + 1 < n {
                int lo2 = String.charAt(s, i) & 255;
                int hi2 = String.charAt(s, i + 1) & 255;
                int unit2 = lo2 | (hi2 << 8);
                if unit2 >= 56320 && unit2 <= 57343 {
                    cp = 65536 + ((unit - 55296) << 10) + (unit2 - 56320);
                    i = i + 2;
                }
            }
            r = appendUtf8(r, cp);
        }
        return r;
    }

    // ---------- 统计 ----------

    // UTF-8 字符串里的码点个数（多字节序列算一个）
    pub static int utf8Length(string s) {
        int n = String.len(s);
        int count = 0;
        int i = 0;
        while i < n {
            int b = String.charAt(s, i) & 255;
            if b < 128 { i = i + 1; }
            else if b >= 192 && b < 224 { i = i + 2; }
            else if b >= 224 && b < 240 { i = i + 3; }
            else { i = i + 4; }
            count = count + 1;
        }
        return count;
    }

    // 是否纯 ASCII
    pub static bool isAscii(string s) {
        int n = String.len(s);
        int i = 0;
        while i < n {
            if (String.charAt(s, i) & 255) >= 128 { return false; }
            i = i + 1;
        }
        return true;
    }

    // UTF-8 字节数
    pub static int utf8ByteLength(string s) {
        return String.len(s);
    }

    // UTF-16LE 的码元个数
    pub static int utf16Length(string s) {
        return String.len(s) / 2;
    }

    // 取第 i 个码点（0 基），越界返回 -1
    pub static int codePointAt(string s, int index) {
        int n = String.len(s);
        int count = 0;
        int i = 0;
        while i < n {
            int b0 = String.charAt(s, i) & 255;
            int cp = 0;
            int used = 1;
            if b0 < 128 {
                cp = b0;
            } else if b0 >= 192 && b0 < 224 {
                int b1 = 0;
                if i + 1 < n { b1 = String.charAt(s, i + 1) & 255; }
                cp = ((b0 & 31) << 6) | (b1 & 63);
                used = 2;
            } else if b0 >= 224 && b0 < 240 {
                int b1 = 0;
                int b2 = 0;
                if i + 1 < n { b1 = String.charAt(s, i + 1) & 255; }
                if i + 2 < n { b2 = String.charAt(s, i + 2) & 255; }
                cp = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
                used = 3;
            } else {
                int b1 = 0;
                int b2 = 0;
                int b3 = 0;
                if i + 1 < n { b1 = String.charAt(s, i + 1) & 255; }
                if i + 2 < n { b2 = String.charAt(s, i + 2) & 255; }
                if i + 3 < n { b3 = String.charAt(s, i + 3) & 255; }
                cp = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
                used = 4;
            }
            if count == index { return cp; }
            count = count + 1;
            i = i + used;
        }
        return -1;
    }

    // 码点 -> UTF-8 字符串
    pub static string fromCodePoint(int cp) {
        string r = appendUtf8("", cp);
        return r;
    }



    // ---------- GBK ----------

    pub static string gbkToUtf8(string gbk) {
        int n = String.len(gbk);
        return _yxg_gbk_to_utf8(gbk, n);
    }

    pub static string utf8ToGbk(string utf8) {
        int n = String.len(utf8);
        return _yxg_utf8_to_gbk(utf8, n);
    }
}
