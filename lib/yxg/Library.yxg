    // ---------- 常用快捷方式 ----------

    // MessageBoxA：返回按钮 ID
    pub int messageBox(int hwnd, string text, string caption, int type) {
        return _yxg_callstdcall4_ss(this.sym("MessageBoxA"), hwnd, text, caption, type);
    }

    // 把 C 的 char*（NUL 结尾）读成 YXG 字符串。
    // FFI 直接返回 string 会缺长度头（String.len 读到垃圾），用这个转一下。
    pub static unsafe string cstr(int addr) {
        if addr == 0 {
            return "";
        }
        char* p = addr as char*;
        string r = "";
        int i = 0;
        while i < 8192 {
            char c = p[i];
            if c == 0 {
                break;
            }
            r = r + c;
            i = i + 1;
        }
        return r;
    }}
