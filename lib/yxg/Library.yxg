// 通用调用器：任意参数个数。argptr 用 &args[0] 传入。stdcall 由被调用者清栈，cdecl 由运行时清。
pub native int _yxg_calln_stdcall(int addr, int argptr, int count);
pub native int _yxg_calln_cdecl(int addr, int argptr, int count);

class Library {
    // LoadLibraryA 返回的模块句柄
    int handle;

    // ---------- 打开 / 关闭 ----------

    pub static Library open(string path) {
        Library lib = new Library();
        lib.handle = _yxg_lib_open(path);
        if lib.handle == 0 {
            return null;
        }
        return lib;
    }

    pub int sym(string name) {
        return _yxg_lib_sym(this.handle, name);
    }

    pub void close() {
        if this.handle != 0 {
            _yxg_lib_close(this.handle);
            this.handle = 0;
        }
    }

    pub int handleValue() {
        return this.handle;
    }

    pub int lastError() {
        return _yxg_last_error();
    }

    pub bool isValid() {
        return this.handle != 0;
    }

    // ---------- 调用：cdecl（调用者清栈）----------
    pub int callCdecl0(int addr) {
        return _yxg_callcdecl0(addr);
    }
