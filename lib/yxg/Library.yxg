// yxg.Library —— 运行时动态加载 DLL 并调用其中的函数（2.5.1）
//
// 用法：
//   import yxg.Library;
//
//   Library lib = Library.open("user32.dll");
//   int addr = lib.sym("MessageBoxA");
//   lib.callStdcall4ss(addr, 0, "hi", "title", 0);
//   lib.close();
//
// 注意：这是 unsafe 区域 —— 地址错了、参数个数错了、约定选错了，
//       都会直接 crash（0xC0000005），没有任何检查。

// ---------- 顶层 native：直接用 runtime_ffi.asm 里的原始符号名 ----------

pub native int  _yxg_lib_open(string path);
pub native int  _yxg_lib_sym(int handle, string name);
pub native void _yxg_lib_close(int handle);
pub native int  _yxg_last_error();

